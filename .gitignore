# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Test artifacts
coverage/
.vitest/
playwright-report/
test-results/

# Temporary repros from /debug-local — never commit
# Promote to tests/invariants/<category>/ via /new-invariant or discard
tests/_scratch/

# Env / secrets — NEVER commit
# Patterns are unanchored, so they cover apps/api/.env, apps/web/.env, etc.
# .env.example is the only exception (the committed template).
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Claude session-local
.claude/projects/
.claude/sessions/

# Mongo data dumps (devs sometimes leave these)
*.bson
dump/
