# Backend runtime environment.
#
# Local development: copy this to `apps/api/.env.local`. NestJS reads
# `.env.local` first and falls back to `.env` if missing. Both are gitignored.
# Production: supply via your hosting platform's secret manager (Render,
# Fly, Railway, ECS Secrets Manager, etc.) — no .env file in the build.
#
# Anything in this file is considered SERVER-ONLY. Never duplicate any of
# these into apps/web/.env.local — Vite would risk inlining them into the
# public bundle.

# --- Server ---
NODE_ENV=development
API_PORT=3001
# Origin allowed by CORS. In prod, set to the deployed web origin
# (e.g. https://musy.example.com). Comma-separated for multiple.
WEB_ORIGIN=http://localhost:5173

# --- Database ---
# docker-compose binds host port 27117 (non-default to avoid collisions).
# Production: replace with your MongoDB Atlas / managed Mongo connection string.
MONGO_URI=mongodb://localhost:27117/musy

# --- AI ---
# Anthropic API key for taste-processing features.
ANTHROPIC_API_KEY=
# Optional alternate provider (embeddings, etc.)
OPENAI_API_KEY=

# --- Auth (added when AUTH-01 lands) ---
# 32+ random bytes, hex or base64. Rotate per environment.
# SESSION_SECRET=
# COOKIE_DOMAIN=

# --- Music providers (added when feature lands) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
