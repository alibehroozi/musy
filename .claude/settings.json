{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:invariants)",
      "Bash(npm run test:watch)",
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "deny": [
      "Edit(.env)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Write(.env)",
      "Write(.env.development)",
      "Write(.env.production)",
      "Write(.env.test)"
    ]
  }
}
