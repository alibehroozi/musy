# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Test artifacts
coverage/
.vitest/
playwright-report/
test-results/

# Lost Pixel — only baseline/ is committed (the canonical truth).
# current/ and difference/ are produced on every run; never commit.
# Lost Pixel also auto-writes a redundant .lostpixel/.gitignore on each run;
# the rules above already cover what it would exclude, so we ignore it too.
.lostpixel/current/
.lostpixel/difference/
.lostpixel/.gitignore

# Temporary repros from /debug-local — never commit
# Promote to tests/invariants/<category>/ via /new-invariant or discard
tests/_scratch/

# Env / secrets — NEVER commit
# Patterns are unanchored, so they cover apps/api/.env, apps/web/.env, etc.
# .env.example is the only exception (the committed template).
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Claude session-local
.claude/projects/
.claude/sessions/
.claude/worktrees/

# Mongo data dumps (devs sometimes leave these)
*.bson
dump/
