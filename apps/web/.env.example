# Frontend build-time environment.
#
# Local development: copy this to `apps/web/.env.local`. Vite loads
# `.env.local` automatically (in addition to `.env`) and lets it override.
# Both are gitignored.
# Production: your hosting platform (Vercel/Netlify/Cloudflare Pages)
# provides these at build time via its environment-variable settings — no
# `.env*` file in the deploy.
#
# !!! READ THIS BEFORE ADDING ANYTHING !!!
# Anything prefixed with `VITE_` is INLINED INTO THE PUBLIC BUNDLE during
# build and is visible to anyone who loads the app. Never put secrets here.
# Backend keys (Mongo URI, Anthropic API key, OAuth client secrets, session
# signing keys) belong exclusively in apps/api/.env.local.
#
# Variables WITHOUT the `VITE_` prefix are not exposed to client code, but
# this file is still public-by-convention — keep secrets out of it entirely.

# Where the API lives — the URL the browser hits at runtime.
# - Dev: leave as `/api`. The Vite dev server proxies `/api` → VITE_API_TARGET
#   below, so the browser never makes cross-origin calls.
# - Prod: either keep `/api` (if web and api share the same origin behind a
#   reverse proxy / CDN) or set to the absolute API URL
#   (e.g. https://api.musy.example.com).
VITE_API_URL=/api

# Dev-only: where the Vite dev server proxies `/api` to. Must match the
# API_PORT in apps/api/.env.local. /prepare-local writes both in lock-step
# when it picks a free port for the API.
VITE_API_TARGET=http://localhost:3001

# Dev-only: port for the Vite dev server itself. /prepare-local picks a free
# port if 5173 is taken.
VITE_WEB_PORT=5173
