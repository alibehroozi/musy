{
  "name": "moc",
  "private": true,
  "version": "0.0.1",
  "description": "Music app with AI-powered taste processing. AI-maintained, TDD.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "libs/shared/*",
    "libs/api/*",
    "libs/web/*"
  ],
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --workspaces --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "vitest run tests/invariants",
    "test:api": "npm --workspace apps/api run test",
    "build": "npm --workspaces --if-present run build",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev": "npm-run-all -p dev:api dev:web",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
