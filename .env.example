# Copy to .env and fill in. .env is gitignored — never commit real values.
# CI provides these via GitHub Secrets.

# --- API ---
API_PORT=3001
# docker-compose binds host port 27117 (non-default to avoid collisions).
# Change `musy` to any name — Mongo creates the db on first connect.
MONGO_URI=mongodb://localhost:27117/musy

# --- AI ---
ANTHROPIC_API_KEY=
# Optional: alternate provider for embeddings/etc
OPENAI_API_KEY=

# --- Music providers (added when features land) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
