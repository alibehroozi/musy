# Backend runtime environment.
#
# Local development: copy this to `apps/api/.env.local`. NestJS reads
# `.env.local` first and falls back to `.env` if missing. Both are gitignored.
# Production: supply via your hosting platform's secret manager (Render,
# Fly, Railway, ECS Secrets Manager, etc.) — no .env file in the build.
#
# Anything in this file is considered SERVER-ONLY. Never duplicate any of
# these into apps/web/.env.local — Vite would risk inlining them into the
# public bundle.

# --- Server ---
NODE_ENV=development
# /prepare-local picks a free port if 3001 is taken and writes the chosen
# value here AND into apps/web/.env.local (VITE_API_TARGET) so the dev
# proxy stays in sync. Override manually only if you know what you're doing.
API_PORT=3001
# Origin allowed by CORS. In prod, set to the deployed web origin
# (e.g. https://musy.example.com). Comma-separated for multiple.
# /prepare-local updates this if it picks a non-default web port.
WEB_ORIGIN=http://localhost:5173

# --- Database ---
# docker-compose binds host port 27117 (non-default to avoid collisions).
# Production: replace with your MongoDB Atlas / managed Mongo connection string.
MONGO_URI=mongodb://localhost:27117/musy

# --- AI ---
# Anthropic API key for taste-processing features.
ANTHROPIC_API_KEY=
# Optional alternate provider (embeddings, etc.)
OPENAI_API_KEY=

# --- Auth (Google OAuth) ---
# Get these from Google Cloud Console → APIs & Services → Credentials.
# Create an "OAuth 2.0 Client ID" of type "Web application". The
# "Authorized redirect URI" registered there must match GOOGLE_REDIRECT_URI
# exactly. The "Authorized JavaScript origins" should include WEB_ORIGIN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In local dev the web origin proxies /api/* → API_PORT, so register THIS
# URI in Google Cloud Console. In prod, point at the deployed web origin
# (the proxy) or the API origin directly, whichever fronts /api/auth/google.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# 32+ random bytes for HS256 JWT session signing. Rotate per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Music providers ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Search aggregator ---
# Genius developer token — required for the search aggregator to start.
# Get one at https://genius.com/api-clients (create an API client, copy the access token).
# The API will refuse to start (bootstrap fails) if this is blank.
GENIUS_ACCESS_TOKEN=
# App name sent to Audius for rate-limiting identification. Optional; defaults to "moc".
AUDIUS_APP_NAME=moc
